*.py[cod]
*.so
*.pyd
*.egg-info/
*.egg
.eggs/
build/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
.env
.envrc
.python-version

# Notebook checkpoints
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

