work_dirs/
runs/
logs/
*.log

# Large binary artefacts — live on Figshare, NOT GitHub
*.pth
*.pt
*.ckpt
*.safetensors
data/raw/
data/frames/
data/masks/
data/annotations/*.png
data/routes/*.mp4
data/routes/*.avi
data/splits/*.txt
results/
*.parquet
*.feather

# Allow lightweight Markdown / TXT placeholders inside pointer dirs
!data/**/README.md
!data/**/*.md
!checkpoints/README.md
!checkpoints/EXPECTED.txt
